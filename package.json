{
  "name": "premium-news-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/ui",
    "packages/config"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/api",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "^12.2.0"
  }
}
