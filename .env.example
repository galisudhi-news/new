# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for docker-compose, or use the per-app files:
#   apps/api/.env         local API
#   apps/web/.env.local   local website
#   apps/api/.env.vercel  values to paste into the Vercel API project
#   apps/web/.env.vercel  values to paste into the Vercel website project
# All of those are gitignored. See docs/DEPLOY-VERCEL.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Read by the application code ─────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# API: PostgreSQL. On serverless use a POOLED connection string.
DATABASE_URL=postgresql://news:news@localhost:5432/news

# API: signing key for admin sessions. openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Web: bare API origin, no /api suffix — the client appends it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web: this site's own public URL (canonical links, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web: "true" allows search engines to index. Preview/demo hosts are blocked
# automatically, so leave this unset until a real domain is configured.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Infrastructure from docker-compose, not yet read by application code ──────

REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://news:news@rabbitmq:5672
ELASTICSEARCH_URL=http://elasticsearch:9200

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=news-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret

# ── Reserved for planned features (refresh tokens, OAuth, mail, analytics) ────

JWT_REFRESH_SECRET=replace-with-another-long-random-secret
NEXTAUTH_SECRET=replace-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

GA_MEASUREMENT_ID=
MATOMO_URL=
MATOMO_SITE_ID=

SENTRY_DSN=
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_SITE_NAME=Gāḷi Suddi
